# ============================================================
# Tax Solver — Environment Variables
# העתק קובץ זה ל-.env.local ומלא את הערכים
# לעולם אל תכניס ערכים אמיתיים לקובץ זה!
# ============================================================

# --- Supabase (https://supabase.com/dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here   # SERVER ONLY — לעולם לא לצד הלקוח

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here           # SERVER ONLY

# --- Upstash Redis — Rate Limiting (https://console.upstash.com) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000          # בפרודקשן: https://yourdomain.com
NODE_ENV=development

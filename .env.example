# ============================================================
# Tax Solver AI — Environment Variables
# ============================================================
# להרצה מיידית ב-Standalone Mode (ללא שום API):
#   cp .env.example .env.local
#   npm install && npm run dev
#   → http://localhost:3000 (לחץ "⚡ כנס עכשיו")
# ============================================================

# --- Standalone mode — ערכים אלה מאפשרים הרצה מיידית ---
ANTHROPIC_API_KEY=placeholder
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# להוסיף שירותים אמיתיים (אופציונלי):
# ============================================================

# --- Claude API לתשובות AI אמיתיות (https://console.anthropic.com) ---
# ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Supabase לאימות משתמשים + DB (https://supabase.com) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Upstash Redis לRate Limiting (https://console.upstash.com) ---
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

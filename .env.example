# ============================================================
# Tax Solver v2 — Environment Variables
# העתק קובץ זה ל-.env.local ומלא את הערכים
# לעולם אל תכניס ערכים אמיתיים לקובץ זה!
# ============================================================

# --- Claude API (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-api03-...                # SERVER ONLY

# --- Supabase (https://supabase.com/dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY — לעולם לא לצד הלקוח

# --- Upstash Redis — Rate Limiting (https://console.upstash.com) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- Twilio WhatsApp (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000          # בפרודקשן: https://yourdomain.com
NODE_ENV=development

# --- Cron Security ---
CRON_SECRET=change-this-to-a-random-secret
